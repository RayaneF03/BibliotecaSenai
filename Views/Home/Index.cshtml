@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="container-fluid bg-primary text-light py-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Sistema de Biblioteca</h1>
        <p class="lead mt-3">
            Gerenciamento de livros, autores e empréstimos
        </p>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <a href="@Url.Action("Index", "Livros")" class="btn btn-light btn-lg">
                📚 Livros
            </a>
            <a href="@Url.Action("Index", "Autores")" class="btn btn-outline-light btn-lg">
                ✍️ Autores
            </a>
            <a href="@Url.Action("Index", "Emprestimos")" class="btn btn-outline-light btn-lg">
                🔄 Empréstimos
            </a>
        </div>
    </div>
</div>

<!-- SEÇÕES -->
<div class="container mt-5">

    <div class="row g-4">

        <!-- LIVROS -->
        <div class="col-md-4">
            <div class="card h-100 shadow">
                <div class="card-body">
                    <h5 class="card-title">📚 Livros</h5>
                    <p class="card-text">
                        Cadastre, edite e visualize os livros disponíveis na biblioteca.
                    </p>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Livros")" class="btn btn-primary">
                            Listar
                        </a>
                        <a href="@Url.Action("Create", "Livros")" class="btn btn-outline-primary">
                            Novo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- AUTORES -->
        <div class="col-md-4">
            <div class="card h-100 shadow">
                <div class="card-body">
                    <h5 class="card-title">✍️ Autores</h5>
                    <p class="card-text">
                        Gerencie os autores relacionados aos livros.
                    </p>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Autores")" class="btn btn-primary">
                            Listar
                        </a>
                        <a href="@Url.Action("Create", "Autores")" class="btn btn-outline-primary">
                            Novo
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- EMPRÉSTIMOS -->
        <div class="col-md-4">
            <div class="card h-100 shadow">
                <div class="card-body">
                    <h5 class="card-title">🔄 Empréstimos</h5>
                    <p class="card-text">
                        Controle de empréstimos e devoluções dos livros.
                    </p>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Emprestimos")" class="btn btn-primary">
                            Listar
                        </a>
                        <a href="@Url.Action("Create", "Emprestimos")" class="btn btn-outline-primary">
                            Novo
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- RODAPÉ -->
<footer class="container text-center mt-5 text-muted">
    <hr />
    <p>Projeto acadêmico – ASP.NET MVC</p>
</footer>
